{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/manifest.webmanifest", "destination": "/api/manifest" },
    { "source": "/favicon.ico", "destination": "/api/tenant-icon?size=64&format=png" },
    { "source": "/favicon.png", "destination": "/api/tenant-icon?size=64&format=png" },
    { "source": "/app-icon.png", "destination": "/api/tenant-icon?size=512&format=png" },
    { "source": "/download", "destination": "/api/download-app" },
    { "source": "/app", "destination": "/api/download-app" },
    { "source": "/superadmin", "destination": "/superadmin.html" },
    { "source": "/:slug([a-z0-9-]+)", "destination": "/?c=:slug" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(sw.js|manifest.webmanifest|version.json)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
