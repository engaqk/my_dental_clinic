rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow read/write for all tenants and their subcollections
    match /tenants/{tenantId} {
      allow read, write: if true;
      
      match /appointments/{appointmentId} {
        allow read, create, update: if true; 
        allow delete: if true; // Since admin bypass is used
      }

      match /settings/{docId} {
        allow read, write: if true;
      }
      
      match /marketing_contacts/{contactId} {
        allow read, write: if true; 
      }
      
      match /broadcast_history/{historyId} {
        allow read, write: if true;
      }

      match /clinical_notes/{noteId} {
        allow read, write: if true;
      }

      match /diagnoses/{diagnosisId} {
        allow read, write: if true;
      }

      match /payments/{paymentId} {
        allow read, write: if true;
      }

      match /login_history/{historyId} {
        allow read, write: if true;
      }
    }

    // Keep legacy root paths accessible for migration
    match /appointments/{appointmentId} {
      allow read, create, update: if true; 
      allow delete: if true; 
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    // --- DEFAULT SECURITY GATE ---
    match /{document=**} {
      allow read, write: if true; 
    }
  }
}
